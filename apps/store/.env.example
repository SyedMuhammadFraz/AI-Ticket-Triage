# Fernway Office Supply (the host store). Copy to .env.local. Never commit real secrets.

# The store has its own database, separate from Triage Desk's.
# Local: `npm run db:local` (repo root) starts it on port 5434.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5434/postgres

# At least 32 random characters — signs customer sessions. Generate: openssl rand -hex 32
APP_SECRET=

# ── Triage Desk integration ────────────────────────────────────────────────
# Filled in automatically by:  npm run integration:connect-store -w apps/triage
# TRIAGE_API_URL=http://localhost:3001
# TRIAGE_API_KEY=td_live_…            # server-side only, never exposed to the browser
# TRIAGE_WEBHOOK_SECRET=whsec_…       # verifies events sent to /api/webhooks/triage
