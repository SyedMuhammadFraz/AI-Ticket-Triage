# Copy to .env.local and fill in. Never commit real secrets.

# ── Database ────────────────────────────────────────────────────────────────
# Local: `npm run db:local` starts an embedded Postgres (PGlite) on port 5433.
# Hosted: paste your Neon (or any Postgres 15+) connection string instead.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres

# ── Security ────────────────────────────────────────────────────────────────
# At least 32 random characters. Generate one with: openssl rand -hex 32
APP_SECRET=

# Passcode for the agent dashboard. Leave unset locally; SET IT on any public
# deployment so strangers can't approve replies. At least 8 characters.
# AGENT_PASSCODE=

# Optional. Bearer token for POST /api/jobs/process-queue (e.g. Vercel Cron).
# Leave unset to disable the endpoint. Generate with: openssl rand -hex 32
# CRON_SECRET=

# ── AI provider ─────────────────────────────────────────────────────────────
# "mock" = deterministic offline rules (no key needed). "gemini" = Google Gemini.
AI_PROVIDER=mock
# GEMINI_API_KEY=
# Check https://ai.google.dev/gemini-api/docs/models for current model ids and free-tier limits.
# gemini-3.5-flash-lite is fast and reliable on the free tier (15 requests/minute);
# gemini-3.8-flash is stronger but was often overloaded (HTTP 503) on the free tier in testing.
# GEMINI_MODEL=gemini-3.5-flash-lite
# AI_TIMEOUT_MS=25000
# Space out AI calls to stay under a requests-per-minute quota (each ticket uses up to 2 calls).
# AI_MAX_RPM=12

# Optional list prices (USD per 1M tokens) so the stats bar shows cost per ticket.
# Check your model's current pricing: https://ai.google.dev/gemini-api/docs/pricing
# AI_PRICE_INPUT_PER_MTOK=
# AI_PRICE_OUTPUT_PER_MTOK=

# Demo switch: make every AI call fail to show safe failure and retry.
AI_FORCE_FAIL=false

# ── Integration API & webhooks ──────────────────────────────────────────────
# API_RATE_LIMIT_PER_MINUTE=120      # per API key
# Allow webhook URLs on http/localhost/private networks. Defaults to true in
# development and FALSE in production (SSRF protection). Only set it to true in
# production if your receiver genuinely lives on a private network.
# WEBHOOK_ALLOW_PRIVATE_NETWORK=false

# ── Triage tuning ───────────────────────────────────────────────────────────
# TRIAGE_MIN_CONFIDENCE=0.6   # below this, a human reviews the ticket
# KB_MIN_SCORE=0.25           # minimum article relevance to count as a match
# TRIAGE_MAX_ATTEMPTS=3       # automatic retries before a ticket is marked failed
# SUBMISSION_RATE_LIMIT=5     # tickets per IP address per 10 minutes
